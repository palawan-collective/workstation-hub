# MerQato Workstation edge-routing example.
#
# This mirrors the live production topology as of 21 Nov 2026: one dashboard,
# one URL. All dashboard traffic lands on https://work.merqato.digital behind
# Cloudflare Access; home. and dash. are permanent redirects. The legacy
# Homepage container (3003) is stopped and must not be re-enabled.

home.merqato.digital {
	redir https://work.merqato.digital{uri} permanent
}

work.merqato.digital {
	basic_auth {
		david@merqato.digital <bcrypt-hash>
	}
	handle_path /files/* {
		reverse_proxy http://host.docker.internal:3004
	}
	handle_path /hub/* {
		reverse_proxy http://host.docker.internal:3010
	}
	reverse_proxy http://host.docker.internal:3005
	encode gzip
}

dash.merqato.digital {
	redir https://work.merqato.digital{uri} permanent
}
